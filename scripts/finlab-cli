@auth.command()
@click.option('--interactive', is_flag=True, help='Interactive setup')
@click.option('--token', help='FinLab API token')
@click.option('--db-host', help='Database host')
@click.option('--db-port', type=int, help='Database port')
@click.option('--test', is_flag=True, help='Test connection after setup')
@click.pass_context
def setup(ctx, interactive, token, db_host, db_port, test):
    """Configure FinLab API credentials."""
    console.print("[blue]Setting up FinLab authentication...[/blue]")

    if interactive:
        console.print("[yellow]Interactive mode not fully implemented[/yellow]")
        # Would implement interactive prompts here
        console.print("Would prompt for:")
        console.print("  - FinLab API token")
        console.print("  - Database connection details")
        console.print("  - Authentication preferences")
    else:
        if token:
            console.print(f"  Token: {'*' * (len(token)-4) + token[-4:] if len(token) > 4 else '****'}")
        if db_host:
            console.print(f"  Database: {db_host}:{db_port or 5432}")

    if HAS_ADVANCED_FEATURES:
        try:
            auth = create_finlab_authenticator()
            console.print(f"  Current auth status: {format_status('configured' if auth.config.has_token_auth or auth.config.has_db_auth else 'not configured')}")
        except Exception as e:
            console.print(f"[yellow]Warning: Could not check auth status: {e}[/yellow]")

    console.print("[green]Authentication setup completed[/green]")

    if test:
        # Call the test command
        ctx.invoke(test_auth)


@auth.command()
@click.option('--verbose', is_flag=True, help='Show detailed test results')
@click.pass_context
def test(ctx, verbose):
    """Test authentication and connection."""
    console.print("[blue]Testing FinLab authentication...[/blue]")

    if HAS_ADVANCED_FEATURES:
        try:
            auth = create_finlab_authenticator()

            # Test token auth
            if auth.config.has_token_auth:
                console.print("  ✅ Token authentication: Configured")
            else:
                console.print("  ❌ Token authentication: Not configured")

            # Test database auth
            if auth.config.has_db_auth:
                console.print("  ✅ Database authentication: Configured")
            else:
                console.print("  ❌ Database authentication: Not configured")

            # Test connection
            config = FinLabConfig(auth_config=auth.config)
            connector = FinLabConnector(config)

            with console.status("[blue]Testing connection..."):
                if connector.test_connection():
                    console.print("  ✅ Connection test: Successful")
                else:
                    console.print("  ❌ Connection test: Failed")

        except Exception as e:
            console.print(f"  ❌ Authentication test failed: {e}")
            if verbose:
                import traceback
                traceback.print_exc()
    else:
        console.print("  [yellow]Advanced authentication testing not available[/yellow]")
        console.print("  [yellow]Basic configuration check: Not implemented[/yellow]")


