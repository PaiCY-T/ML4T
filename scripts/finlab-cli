        from src.cli.commands.troubleshoot import troubleshoot_group

        cli.add_command(pipeline_group, name='pipeline')
        cli.add_command(validation_group_advanced, name='validation')
        cli.add_command(monitoring_group, name='monitoring')
        cli.add_command(data_group, name='data')
        cli.add_command(config_group, name='config')
        cli.add_command(batch_group, name='batch')
        cli.add_command(troubleshoot_group, name='troubleshoot')

        console.print("[dim]✅ Advanced command groups loaded successfully[/dim]")
    except ImportError as e:
        console.print(f"[yellow]Warning: Some advanced command groups not available: {e}[/yellow]")

# Add performance and db as command groups
cli.add_command(performance)
cli.add_command(db)


if __name__ == '__main__':
    cli()