#!/usr/bin/env python3
"""
FinLab Data Downloader CLI Entry Point

This script provides the command-line interface for the FinLab data downloader.
"""

import sys
import os

# Add src directory to Python path
current_dir = os.path.dirname(os.path.abspath(__file__))
project_root = os.path.dirname(current_dir)
src_path = os.path.join(project_root, 'src')
sys.path.insert(0, src_path)

if __name__ == '__main__':
    try:
        from finlab_downloader.cli.main import cli
        cli()
    except ImportError as e:
        print(f"Error: Cannot import FinLab downloader modules: {e}")
        print("Make sure you're running from the project root directory.")
        sys.exit(1)
    except KeyboardInterrupt:
        print("\nOperation cancelled by user.")
        sys.exit(1)
    except Exception as e:
        print(f"Unexpected error: {e}")
        sys.exit(1)